    <bpmn:startEvent id="StartEvent_1" name="AMQP trigger">
      <bpmn:outgoing>Flow_02yvv0c</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1nvmlc7" messageRef="Message_0pc7g1v" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_0mf9n48" name="AMQP send">
      <bpmn:extensionElements>
        <operaton:connector>
          <operaton:connectorId>amqp-connector</operaton:connectorId>
          <operaton:inputOutput>
            <operaton:inputParameter name="message">${message}</operaton:inputParameter>
          </operaton:inputOutput>
        </operaton:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02yvv0c</bpmn:incoming>
